VITE_API_BASE_URL=http://localhost:3001
VITE_PARKING_SERVICE_URL=
# Temporary compatibility values for the legacy login contract. Prefer a backend
# authentication endpoint that does not require a client-embedded encryption key.
VITE_LEGACY_ENCRYPTION_PASSWORD=
VITE_LEGACY_ENCRYPTION_IV=
# Empty uses the API base address + /signalr (IIS). Set explicitly for a separate Windows Service listener.
VITE_ANPR_SIGNALR_URL=
# Optional direct-browser HshDetectionService key. Prefer a browser-safe,
# short-lived credential; do not commit a real key here.
VITE_HSH_DETECTION_API_KEY=

# SSO is loaded from the API endpoint api/Utils/GetClientConfig.
